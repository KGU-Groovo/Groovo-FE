# 로컬 실행용: 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올리지 않습니다.

# BE(Spring Boot) API base URL — context-path(/api)까지 포함합니다.
EXPO_PUBLIC_API_BASE_URL=

# 데모 전용 자동 로그인 계정 (학습 시작 시 POST /api/v1/auth/login에 사용).
# 주의: EXPO_PUBLIC_* 값은 앱 번들에 그대로 포함되므로 secret이 아닙니다.
#       반드시 데모 전용 계정만 사용하고, 실제 사용자 계정은 넣지 마세요.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
